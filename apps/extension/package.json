{
  "name": "saas-coupon-spy-extension",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:popup": "vite build",
    "build:content": "esbuild src/content/contentScript.ts --bundle --outfile=dist/src/content/contentScript.js --format=iife --target=chrome100",
    "build:worker": "esbuild src/background/serviceWorker.ts --bundle --outfile=dist/src/background/serviceWorker.js --format=esm --target=chrome100",
    "build": "tsc && npm run build:popup && npm run build:content && npm run build:worker",
    "package": "node package-extension.js"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
